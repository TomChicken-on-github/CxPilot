{
	"name": "cxpilot",
	"version": "1.0.0",
	"description": "Automated Chaoxing lecture pilot — auto-plays recorded courses and advances chapters hands-free.",
	"license": "MIT",
	"bin": "src/run_loop.js",
	"scripts": {
		"start": "node src/run_loop.js",
		"capture": "node src/main.js",
		"analyze": "node tools/analyze_enc.js",
		"build:exe": "pkg . -t node24-win-x64 --output dist/CxPilot.exe"
	},
	"pkg": {
		"assets": [
			"src/**/*"
		],
		"targets": [
			"node24-win-x64"
		]
	},
	"devDependencies": {
		"@yao-pkg/pkg": "^6.22.0",
		"playwright": "^1.62.1"
	},
	"dependencies": {
		"dotenv": "^17.4.2",
		"prompts": "^2.4.2"
	}
}
